# KYC Screener — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# ── Required for Live Mode ────────────────────────────────────────────────────

# Google AI Studio API key — https://aistudio.google.com/apikey
# Free tier: 20 req/day on Gemini 2.5 Flash, higher on Gemini 2.5 Flash-Lite
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily search API key — https://app.tavily.com/
# Free tier available; used by Research and UBO agents
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Groq API key — https://console.groq.com/
# Activates Tier-3 LLM fallback (llama-3.3-70b-versatile) when all Gemini
# daily quotas are exhausted. Recommended for production.
GROQ_API_KEY=your_groq_api_key_here

# OpenSanctions API key — https://www.opensanctions.org/api/
# Only needed if the local sanctions index (data/sanctions/focused.db.gz)
# is absent. The committed index covers 14 major lists; the live API adds
# coverage for the full 1.3M-entity dataset.
OPENSANCTIONS_API_KEY=your_opensanctions_api_key_here
