# Copy this file to .streamlit/secrets.toml for local use, OR
# paste each key into the Streamlit Cloud dashboard → App settings → Secrets.
#
# Only GEMINI_API_KEY and TAVILY_API_KEY are required to enable Live Mode.
# The rest are optional enhancements.

GEMINI_API_KEY          = "your_gemini_api_key_here"
TAVILY_API_KEY          = "your_tavily_api_key_here"
OPENSANCTIONS_API_KEY   = "your_opensanctions_api_key_here"   # optional — used if local index absent
GROQ_API_KEY            = "your_groq_api_key_here"            # optional — Gemini fallback on quota
